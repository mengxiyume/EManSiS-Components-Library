#include <cstdint>

namespace emansis {

    template <uint8_t Length>
    class bitmap {
    private:
        uint8_t m_arrData[Length ? Length : 1];
    public:
        bitmap(uint8_t initValue = 0) {
            for (uint8_t i = 0; i < Length; ++i) 
                m_arrData[i] = initValue;
        }
        uint8_t operator[](uint8_t index) const {
            return m_arrData[index];
        }
        uint8_t& operator[](uint8_t index) {
            return m_arrData[index];
        }
        uint8_t* data() {
                return m_arrData;
        }
        bool empty() {
            for (int i = 0; i < _countof(m_arrData);) {
                //层级过滤
                if (i + sizeof(int64_t) <= _countof(m_arrData)) {
                    if (((int64_t*)(m_arrData))[i / sizeof(int64_t)] != 0)
                        return false;
                    i += sizeof(int64_t);
                }
                else if (i + sizeof(int32_t) <= _countof(m_arrData)) {
                    if (((int32_t*)(m_arrData))[i / sizeof(int32_t)] != 0)
                        return false;
                    i += sizeof(int32_t);
                }
                else if (i + sizeof(int16_t) <= _countof(m_arrData)) {
                    if (((int16_t*)(m_arrData))[i / sizeof(int16_t)] != 0)
                        return false;
                    i += sizeof(int16_t);
                }
                else {
                    //uint8_t
                    if (m_arrData[i] != 0)
                        return false;
                    ++i;
                }
            }
            return true;
        }
    };
}